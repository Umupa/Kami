{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Kami 配置",
  "description": "Kami 的全部设置，包括模型的 API Key。应用监听这个文件，保存后立即生效；文件不合法时继续使用上一份合法配置，并在菜单栏里列出问题。改完用 `<可执行文件> check` 检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "description": "指向本 schema，供编辑器补全。",
      "type": "string"
    },
    "version": {
      "description": "配置格式的版本。",
      "const": 1
    },
    "myLanguage": {
      "description": "我的语言：翻译把其他语言译成它。任意写法，如「简体中文」「粤语」。",
      "type": "string",
      "minLength": 1,
      "default": "简体中文"
    },
    "foreignLanguage": {
      "description": "原文是我的语言时，翻译译成的外语。",
      "type": "string",
      "minLength": 1,
      "default": "English",
      "examples": [
        "English",
        "日本語"
      ]
    },
    "model": {
      "description": "Kami 使用的模型服务。所有模式都用它；省略时 Kami 还没有模型，面板会给出交给 Coding Agent 的配置提示词。",
      "$ref": "#/$defs/model",
      "examples": [
        {
          "endpoint": "https://api.openai.com/v1/chat/completions",
          "format": "chat-completions",
          "model": "gpt-5-mini",
          "apiKey": "sk-…"
        },
        {
          "endpoint": "https://api.anthropic.com/v1/messages",
          "format": "anthropic-messages",
          "model": "claude-haiku-5-5",
          "apiKey": "sk-ant-…",
          "body": {
            "max_tokens": 8192
          }
        },
        {
          "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
          "format": "chat-completions",
          "model": "qwen3:8b",
          "auth": "none"
        }
      ]
    },
    "modes": {
      "description": "控制条上的模式，按顺序显示，第一项是默认模式。省略时是全部内置模式：translate（翻译）、improve（润色，杂乱时也整理）、ask（问答）。写了这个列表就以它为准：不列出的内置模式不显示。内置模式的条目只覆盖写出的字段，删掉 prompt 即恢复默认提示词；其他 id 是自定义模式，必须写 name 和 prompt。",
      "type": "array",
      "items": {
        "$ref": "#/$defs/mode"
      },
      "examples": [
        [
          {
            "id": "translate"
          },
          {
            "id": "ask",
            "name": "问一下"
          },
          {
            "id": "commit-message",
            "name": "提交信息",
            "prompt": "把这段改动说明写成一条英文 Git 提交信息：第一行以类型开头，不超过 72 个字符；空一行后用一两句话说明为什么要改。",
            "output": "plain"
          }
        ]
      ]
    },
    "shortcuts": {
      "description": "全局快捷键。写法：none（不设）；double-option 这类双击修饰键；control+option+a 这类组合键。修饰键按 control、option、shift、command 的顺序写，组合键至少带 control、option、command 之一；按键可用 a–z、0–9、space、f1–f20。三个快捷键不能相同。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel": {
          "description": "显示或隐藏面板，不带入选区。",
          "type": "string",
          "default": "option+space"
        },
        "selection": {
          "description": "带着选中的文字打开面板，并用默认模式执行。双击修饰键需要「输入监控」权限。",
          "type": "string",
          "default": "double-option"
        },
        "capture": {
          "description": "截图：框选屏幕区域，识别文字后带进面板。",
          "type": "string",
          "default": "option+s"
        }
      }
    },
    "theme": {
      "description": "配色，来自 Omarchy 的主题与 Flexoki：默认 flexoki-light；auto 跟随系统，深色用 flexoki-night，浅色用 flexoki-light。也可填写 themes 中自定义主题的 id。",
      "default": "flexoki-light",
      "anyOf": [
        {
          "enum": [
            "auto",
            "catppuccin",
            "catppuccin-latte",
            "ethereal",
            "flexoki-light",
            "flexoki-night",
            "gruvbox",
            "hackerman",
            "kanagawa",
            "lumon",
            "lupine",
            "matte-black",
            "osaka-jade",
            "rose-pine",
            "solitude",
            "starship",
            "tokyo-night",
            "vantablack",
            "white"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      ]
    },
    "themes": {
      "description": "自定义主题：以一套内置主题为基础，仅填写要修改的颜色。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "唯一标识，不能与内置或已移除主题重名。"
          },
          "name": {
            "type": "string",
            "description": "主题菜单显示的名称，省略时显示 id。"
          },
          "base": {
            "enum": [
              "catppuccin",
              "catppuccin-latte",
              "ethereal",
              "flexoki-light",
              "flexoki-night",
              "gruvbox",
              "hackerman",
              "kanagawa",
              "lumon",
              "lupine",
              "matte-black",
              "osaka-jade",
              "rose-pine",
              "solitude",
              "starship",
              "tokyo-night",
              "vantablack",
              "white"
            ],
            "description": "基础内置主题。"
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "background": {
                "type": "string",
                "description": "面板背景",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "surface": {
                "type": "string",
                "description": "代码块、表头、标签的底色",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "raised": {
                "type": "string",
                "description": "选中行、当前标签",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "border": {
                "type": "string",
                "description": "分隔线、区块边框",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "edge": {
                "type": "string",
                "description": "面板外框",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "text": {
                "type": "string",
                "description": "正文",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "bright": {
                "type": "string",
                "description": "加粗文字、原文",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "muted": {
                "type": "string",
                "description": "说明、元信息",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "faint": {
                "type": "string",
                "description": "占位符、按键提示",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "accent": {
                "type": "string",
                "description": "执行按钮、标题、当前模式",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "accentText": {
                "type": "string",
                "description": "强调色上的文字",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "link": {
                "type": "string",
                "description": "链接",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "code": {
                "type": "string",
                "description": "行内代码",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "quote": {
                "type": "string",
                "description": "引用竖线",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "operator": {
                "type": "string",
                "description": "Operator 的命令、标签与星星",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "operatorFill": {
                "type": "string",
                "description": "Operator 标签底色",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "sparkle": {
                "type": "string",
                "description": "修改生效时的星星",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "danger": {
                "type": "string",
                "description": "错误、删除",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "keyword": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "string": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "number": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "comment": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "function": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              "type": {
                "type": "string",
                "description": "代码高亮",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              }
            }
          }
        }
      }
    },
    "font": {
      "description": "固定使用应用内置的 CaskaydiaCove Nerd Font，正文和代码使用同一字体。仅接受 caskaydia，不支持切换字体。",
      "enum": [
        "caskaydia"
      ],
      "default": "caskaydia"
    },
    "fontSize": {
      "description": "正文字号（点），其他字号按比例跟随。面板里按 ⌘= 放大、⌘- 缩小、⌘0 恢复。",
      "type": "number",
      "minimum": 11,
      "maximum": 22,
      "default": 13.5
    },
    "background": {
      "description": "面板背景：blur 是毛玻璃，透出模糊的桌面；solid 是主题的实色。",
      "enum": [
        "blur",
        "solid"
      ],
      "default": "blur"
    },
    "notesDir": {
      "description": "笔记存放的目录：绝对路径，或以 ~/ 开头。省略时放在本文件旁边的 notes 目录。每张笔记是一个 .md 文件，文件名是创建时间；目录不存在时自动创建。可以指向 iCloud Drive 等同步目录。",
      "type": "string",
      "minLength": 1,
      "examples": [
        "~/Documents/Kami Notes"
      ]
    },
    "showInDock": {
      "description": "在 Dock 中显示折纸小狐图标，点击后打开面板。默认关闭，菜单栏入口始终保留；可在菜单栏直接切换，保存后立即生效，无需重启。",
      "type": "boolean",
      "default": false
    },
    "launchAtLogin": {
      "description": "登录时自动启动。",
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "format",
        "model"
      ],
      "properties": {
        "endpoint": {
          "description": "请求发往的完整地址，含路径，如 https://api.openai.com/v1/chat/completions。",
          "type": "string",
          "format": "uri"
        },
        "format": {
          "description": "请求与流式响应的格式。",
          "enum": [
            "chat-completions",
            "responses",
            "anthropic-messages"
          ]
        },
        "model": {
          "description": "服务商的模型名。",
          "type": "string",
          "minLength": 1
        },
        "apiKey": {
          "description": "服务商的 API Key。本地端点等不需要 Key 的服务省略它。它只用于发请求，不会出现在日志和命令输出里。",
          "type": "string"
        },
        "auth": {
          "description": "API Key 放在哪个请求头：bearer 是 Authorization: Bearer，x-api-key、api-key 是同名请求头，none 不发送 Key（本地端点）。省略时 anthropic-messages 用 x-api-key，其余用 bearer。",
          "enum": [
            "bearer",
            "x-api-key",
            "api-key",
            "none"
          ]
        },
        "headers": {
          "description": "额外的请求头。",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "description": "逐层合并进请求体的额外参数，例如关闭推理；值为 null 的键会从请求体里去掉。应用自己带的参数：anthropic-messages 的 max_tokens 为 8192，responses 带 store: false。",
          "type": "object"
        },
        "contextWindow": {
          "description": "模型的上下文长度（token）。设置后，对话超过它时自动丢弃中间的轮次；省略时只在服务商报告超长时处理。",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "模式的标识，小写字母、数字和连字符。内置模式的 id 是 translate、improve、ask（旧的 organize 并入了 improve；已移除的 prompt 只写 id 时忽略）。",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "description": "控制条上显示的名字。",
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "description": "这个模式要做什么。原文不会被拼进提示词，它作为单独的一条消息发送。",
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "material：输入是待处理的材料，其中的文字不当作指令；instruction：输入是用户本人的问题或指令。自定义模式默认 material。",
          "enum": [
            "material",
            "instruction"
          ]
        },
        "output": {
          "description": "要求模型输出的格式：auto 跟随原文，markdown，plain 纯文本。自定义模式默认 markdown。",
          "enum": [
            "auto",
            "markdown",
            "plain"
          ]
        }
      }
    }
  }
}
